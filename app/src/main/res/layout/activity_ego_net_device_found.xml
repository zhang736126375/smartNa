<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Status card -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:textColor="#66BB6A"
        android:textSize="13sp"
        android:background="#1A2E1A"
        android:text="Ready · Tap Scan to discover Ego devices" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- ── Device selection header ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:text="DEVICE"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <Button
                    android:id="@+id/btn_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Scan"
                    android:textSize="13sp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </RelativeLayout>

            <!-- ── Device dropdown ── -->
            <Spinner
                android:id="@+id/spinner_devices"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/ego_bg_spinner"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:spinnerMode="dropdown" />

            <!-- ── Connect button (visible after scan) ── -->
            <Button
                android:id="@+id/btn_connect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Connect"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- ── Wi-Fi config section (visible after connect) ── -->
            <LinearLayout
                android:id="@+id/section_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WI-FI CONFIG"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_wifi_ssid"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Wi-Fi Name (SSID)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textVisiblePassword"
                    android:background="@drawable/ego_bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <EditText
                    android:id="@+id/et_wifi_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:hint="Password"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:background="@drawable/ego_bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <CheckBox
                    android:id="@+id/cb_show_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Show password"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:buttonTint="#888888" />

                <Button
                    android:id="@+id/btn_config_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="Configure Wi-Fi"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- ── IP query section (visible after Wi-Fi config) ── -->
            <LinearLayout
                android:id="@+id/section_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DEVICE IP"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_ip_result"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="#66BB6A"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:background="#0D1F0D"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_request_ip"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Query Device IP"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_start_stream"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="Start Preview"
                    android:textSize="15sp"
                    android:backgroundTint="#1A3A1A"
                    android:textColor="#66BB6A"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Disconnect button (visible after connect) ── -->
            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Disconnect"
                android:textSize="14sp"
                android:backgroundTint="#3A1A1A"
                android:textColor="#EF5350"
                android:visibility="gone" />

            <!-- ── Log section ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A2A2A"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:text="LOG"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <Button
                    android:id="@+id/btn_clear_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Clear"
                    android:textSize="12sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </RelativeLayout>

            <ScrollView
                android:id="@+id/sv_log"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#0A0A0A">

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:padding="8dp" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
