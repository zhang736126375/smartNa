<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartNa" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_active</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_active</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/card_white</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="bottomNavigationStyle">@style/Widget.SmartNa.BottomNav</item>
    </style>

    <style name="Theme.SmartNa.Staff" parent="Theme.SmartNa">
        <item name="colorPrimary">@color/staff_primary</item>
        <item name="colorPrimaryVariant">@color/staff_primary_dark</item>
        <item name="colorSecondary">@color/staff_primary</item>
        <item name="colorSecondaryVariant">@color/staff_primary_dark</item>
    </style>

    <style name="Theme.SmartNa.Launch" parent="Theme.SmartNa">
        <item name="android:windowAnimationStyle">@style/Animation.SmartNa.Instant</item>
    </style>

    <style name="Theme.SmartNa.Launch.Staff" parent="Theme.SmartNa.Staff">
        <item name="android:windowAnimationStyle">@style/Animation.SmartNa.Instant</item>
    </style>

    <style name="Theme.SmartNa.Capture" parent="Theme.SmartNa">
        <item name="android:statusBarColor">@color/capture_hud</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/capture_hud</item>
        <item name="android:navigationBarColor">@color/capture_hud</item>
    </style>

    <style name="Theme.SmartNa.TeachVideo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SmartNa.Login" parent="Theme.SmartNa">
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/card_white</item>
        <item name="android:windowAnimationStyle">@style/Animation.SmartNa.Instant</item>
    </style>

    <style name="Animation.SmartNa.Instant" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/instant</item>
        <item name="android:activityOpenExitAnimation">@anim/instant</item>
        <item name="android:activityCloseEnterAnimation">@anim/instant</item>
        <item name="android:activityCloseExitAnimation">@anim/instant</item>
        <item name="android:taskOpenEnterAnimation">@anim/instant</item>
        <item name="android:taskOpenExitAnimation">@anim/instant</item>
        <item name="android:taskCloseEnterAnimation">@anim/instant</item>
        <item name="android:taskCloseExitAnimation">@anim/instant</item>
        <item name="android:taskToFrontEnterAnimation">@anim/instant</item>
        <item name="android:taskToFrontExitAnimation">@anim/instant</item>
        <item name="android:taskToBackEnterAnimation">@anim/instant</item>
        <item name="android:taskToBackExitAnimation">@anim/instant</item>
    </style>

    <style name="MainTabItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="MainTabIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="MainTabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.SmartNa.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="Widget.SmartNa.Card.Float" parent="Widget.SmartNa.Card">
        <item name="cardElevation">6dp</item>
    </style>

    <style name="Widget.SmartNa.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/selector_tab_color</item>
        <item name="itemTextColor">@color/selector_tab_color</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/card_white</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemRippleColor">@android:color/transparent</item>
    </style>
</resources>
